{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/sw.ts",
    "worker/**/*.spec.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**/*.ts",
    "e2e/**/*.ts"
  ],
  "project": ["src/**/*.{ts,vue}", "worker/**/*.ts"],
  "ignore": [],
  "ignoreBinaries": [],
  "ignoreDependencies": ["@testing-library/vue", "@typescript/native"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "error",
    "unresolved": "error"
  }
}
